{
  "llm": {
    "system_prompt": "Sen yardımcı, net ve doğru bilgi veren bir Türkçe asistansın.",
    "temperature": 0.3,
    "max_tokens": 512
  },
  "sensors": {
    "power_pin": {
      "chip": "gpiochip0",
      "bcm": 13,
      "active_high": true,
      "settle_ms": 250
    },
    "bme280":   { "enabled": true, "sample_rate_hz": 1,  "i2c_address": "0x76" },
    "mpu6050":  { "enabled": true, "sample_rate_hz": 50, "i2c_address": "0x68" },
    "qmc5883l": { "enabled": true, "sample_rate_hz": 10, "i2c_address": "0x0D" }
  }
}