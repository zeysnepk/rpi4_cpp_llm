{
    "mode": "sim",
    "llm": {
        "temperature": 0.2,
        "max_tokens": 200
    },
    "thresholds": {
        "bme280.temperature_c":  { "min": 15,    "max": 35,    "label": "room temperature" },
        "bme280.humidity_pct":   { "min": 20,    "max": 75,    "label": "comfort humidity" },
        "bme280.pressure_hpa":   { "min": 980,   "max": 1040,  "label": "atmospheric pressure" },
        "mpu6050.accel_g.x":     { "min": -0.5,  "max": 0.5,   "label": "X accel (static)" },
        "mpu6050.accel_g.y":     { "min": -0.5,  "max": 0.5,   "label": "Y accel (static)" },
        "mpu6050.accel_g.z":     { "min": 0.80,  "max": 1.20,  "label": "Z accel (gravity)" },
        "mpu6050.gyro_dps.x":    { "min": -10.0, "max": 10.0,  "label": "gyro X (static)" },
        "mpu6050.gyro_dps.y":    { "min": -10.0, "max": 10.0,  "label": "gyro Y (static)" },
        "mpu6050.gyro_dps.z":    { "min": -10.0, "max": 10.0,  "label": "gyro Z (static)" },
        "mpu6050.temp_c":        { "min": 15,    "max": 60,    "label": "MPU internal temperature" }
    },
    "sensors": {
        "bme280":   { "enabled": true, "sample_rate_hz": 20 },
        "mpu6050":  { "enabled": true, "sample_rate_hz": 100 },
        "qmc5883l": { "enabled": true, "sample_rate_hz": 10 }
    }
}
